@startuml class_diagram_view
skinparam classAttributeIconSize 0
skinparam dpi 150
skinparam packageStyle rectangle

title VIEW LAYER - Class Diagram

package "View" {
    
    package "Interfaces" {
        interface IView {
            +initialize() : bool
            +shutdown() : void
            +isRunning() : bool
            +processEvents() : void
            +render() : void
        }
        
        interface IWindowComponent {
            +render() : void
        }
    }
    
    package "Managers" {
        class LifecycleManager {
            -mWindow : SDL_Window
            -mRenderer : SDL_Renderer
            -mInitialized : bool
            +LifecycleManager()
            +initialize(width, height, title) : bool
            +shutdown() : void
            +processEvents(running) : void
            +getWindow() : SDL_Window
            +getRenderer() : SDL_Renderer
            +getWindowWidth() : int
            +getWindowHeight() : int
            +beginFrame() : void
            +endFrame() : void
            -setupStyle() : void
        }
        
        class AssetManager {
            -mRenderer : SDL_Renderer
            -mCoverCache : map
            +AssetManager(renderer)
            +clearCache() : void
            +drawAlbumCover(dl, pos, size, cacheKey, data) : void
            -createTextureFromMemory(data) : SDL_Texture
        }
    }
    
    package "UI Components" {
        class ImGuiView <<facade>> {
            -mController : IAppController
            -mPlayerState : IPlayerState
            -mLifecycle : LifecycleManager
            -mAssetManager : AssetManager
            -mMainContent : MainContent
            -mRightSidebar : RightSidebar
            -mPlayerBar : PlayerBar
            -mRunning : bool
            -mPlaylistDirty : atomic_bool
            +ImGuiView(controller, playerState)
            +initialize() : bool
            +shutdown() : void
            +isRunning() : bool
            +processEvents() : void
            +render() : void
            -updatePlaylistData() : void
        }
        
        class MainContent {
            -mController : IAppController
            -mPlayerState : IPlayerState
            -mAssetManager : AssetManager
            -mPlaylistDisplay : vector_string
            -mSearchQuery : char_array
            -mMainTabIndex : int
            -mShowPlaylistDetail : bool
            -mSelectedPlaylistIndex : int
            -mViewMode : ViewMode
            -mPlaylistManager : PlaylistManager
            +MainContent(controller, playerState, assetManager)
            +render() : void
            +setPlaylist(playlist) : void
            -renderSearch() : void
            -renderTabs() : void
            -renderMusicTab(mainW, contentH) : void
            -renderPlaylistTab() : void
            -renderPlaylistDetailView() : void
            -renderCreatePlaylistModal() : void
            -renderEditPlaylistModal() : void
            -renderDeleteConfirmModal() : void
            -renderAddToPlaylistMenu() : void
        }
        
        class RightSidebar {
            -mController : IAppController
            -mPlayerState : IPlayerState
            -mAssetManager : AssetManager
            -mPlaylistDisplay : vector_string
            -mRightTabIndex : int
            -mPortBuffer : char_array
            -mAvailablePorts : vector_string
            -mSelectedPortIndex : int
            -mStorageDevices : vector
            -mSelectedStorageIndex : int
            +RightSidebar(controller, playerState, assetManager)
            +render() : void
            +setPlaylist(playlist) : void
            -renderNowPlaying(dl) : void
            -renderTabs() : void
            -renderQueue(dl, width, currentTrack) : void
            -renderRecent(dl, width) : void
            -renderConnectionPanel() : void
            -refreshPorts() : void
            -renderStoragePanel() : void
            -refreshStorage() : void
        }
        
        class PlayerBar {
            -mController : IAppController
            -mPlayerState : IPlayerState
            -mAssetManager : AssetManager
            -mWasPlaying : bool
            -mPlayStartTime : time_point
            -mPlayStartPos : uint32
            -mLastTrackPath : string
            -mLastTrack : int
            -mIsDraggingSlider : bool
            -mLastPlaybackVersion : uint32
            +PlayerBar(controller, playerState, assetManager)
            +render() : void
            +update(windowWidth, windowHeight) : void
            -stripExtension(name) : string
        }
    }
    
    package "Playlist" {
        class PlaylistData <<struct>> {
            +name : string
            +desc : string
            +colorIdx : int
            +trackPaths : vector_string
        }
        
        enum ViewMode {
            NORMAL
            CREATE_PLAYLIST
            EDIT_PLAYLIST
        }
        
        class PlaylistManager {
            -mPlaylists : vector_PlaylistData
            -mDefaultPlaylistsPopulated : bool
            +PlaylistManager()
            +createPlaylist(name, desc, colorIdx) : void
            +updatePlaylist(idx, name, desc, colorIdx) : void
            +deletePlaylist(idx) : void
            +addTrackToPlaylist(playlistIdx, trackPath) : void
            +removeTrackFromPlaylist(playlistIdx, trackIdx) : void
            +getPlaylistCount() : size_t
            +getPlaylist(idx) : PlaylistData
            +getPlaylistMutable(idx) : PlaylistData
            +getAllPlaylists() : vector
            +populateDefaultPlaylists(controller) : void
            +isDefaultPopulated() : bool
        }
    }

    ImGuiView ..|> IView
    MainContent ..|> IWindowComponent
    RightSidebar ..|> IWindowComponent
    PlayerBar ..|> IWindowComponent
    
    ImGuiView *-- LifecycleManager
    ImGuiView *-- AssetManager
    ImGuiView *-- MainContent
    ImGuiView *-- RightSidebar
    ImGuiView *-- PlayerBar
    
    MainContent *-- PlaylistManager
    MainContent --> PlaylistData : manages
}

@enduml
