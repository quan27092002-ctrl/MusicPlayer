@startuml "seq_load_track"
title CONTROLLER LAYER - Load Track Flow
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center

actor User
participant "View\n(ImGuiView)" as View #LightGreen
participant "AppController" as AC
participant "PlaybackControllerImpl" as PBC
participant "AudioPlayer" as AP
participant "AudioLoaderImpl" as ALI
participant "MediaFile" as MF #LightYellow
participant "MediaMetadata" as MM #LightYellow
participant "PlayerState" as PS #LightYellow

User -> View : 1. selectTrack(index)
activate View
View -> AC : 1.1. loadTrack(filePath)
activate AC
AC -> PBC : 1.1.1. loadTrack(filePath)
activate PBC

' Create MediaFile and extract metadata
PBC -> MF : 1.1.1.1. create(filePath)
activate MF
MF -> MM : 1.1.1.1.1. extractMetadata()
activate MM
note right of MM : Uses TagLib\nto read ID3 tags
MM --> MF : 1.1.1.1.2. return metadata
deactivate MM
MF --> PBC : 1.1.1.2. return MediaFilePtr
deactivate MF

' Load audio file
PBC -> AP : 1.1.1.3. loadFile(filePath)
activate AP
AP -> ALI : 1.1.1.3.1. loadFile(filePath)
activate ALI

alt file exists and valid format
    ALI -> ALI : 1.1.1.3.1.1. loadMUS(path)
    ALI --> AP : 1.1.1.3.2. return success
else file not found or invalid
    ALI --> AP : 1.1.1.3.2. return error
end
deactivate ALI
AP --> PBC : 1.1.1.4. return result
deactivate AP

' Update state
PBC -> PS : 1.1.1.5. setCurrentTrack(index)
activate PS
PS --> PBC : 1.1.1.6. return
deactivate PS

PBC --> AC : 1.1.2. return success
deactivate PBC
AC --> View : 1.2. notifyTrackLoaded()
deactivate AC
View --> User : 2. updateNowPlaying()
deactivate View

@enduml
