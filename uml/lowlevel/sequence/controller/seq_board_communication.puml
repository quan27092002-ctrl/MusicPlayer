@startuml "seq_board_communication"
title CONTROLLER LAYER - Board Communication Flow
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center

actor User
participant "View" as View #LightGreen
participant "S32K144 Board" as Board #LightCoral
participant "SerialManager" as SM
participant "SerialIOImpl" as SIO
participant "BoardCommunicator" as BC
participant "AppController" as AC
participant "PlaybackControllerImpl" as PBC
participant "VolumeControllerImpl" as VC


== 1. Button Press: PLAY ==
User -> Board : 1. pressPlayButton()
activate Board
Board -> SM : 1.1. sendData("cmd:play\\n")
deactivate Board
activate SM
SM -> SIO : 1.1.1. readLine()
activate SIO
SIO --> SM : 1.1.1.1. return "cmd:play"
deactivate SIO

SM -> BC : 1.1.2. onDataReceived("cmd:play")
activate BC
BC -> BC : 1.1.2.1. parseCommand("cmd:play")

alt commandType == "play"
    BC -> AC : 1.1.2.2. play()
    activate AC
    AC -> PBC : 1.1.2.2.1. play()
    activate PBC
    PBC --> AC : 1.1.2.2.2. return
    deactivate PBC
    AC --> BC : 1.1.2.3. return
    deactivate AC
else commandType == "pause"
    BC -> AC : 1.1.2.2. pause()
else commandType == "next"
    BC -> AC : 1.1.2.2. next()
else commandType == "prev"
    BC -> AC : 1.1.2.2. previous()
end

BC --> SM : 1.1.3. return
deactivate BC
SM --> View : 1.2. notifyStateChanged()
deactivate SM

== 2. Volume Knob Adjustment ==
User -> Board : 2. rotateVolumeKnob()
activate Board
Board -> SM : 2.1. sendData("VR: 2048\\n")
deactivate Board
activate SM
SM -> SIO : 2.1.1. readLine()
activate SIO
SIO --> SM : 2.1.1.1. return "VR: 2048"
deactivate SIO

SM -> BC : 2.1.2. onDataReceived("VR: 2048")
activate BC
BC -> BC : 2.1.2.1. parseVolumeValue(2048)
note right of BC : ADC 0-4095\n→ Volume 0-100%
BC -> AC : 2.1.2.2. setVolume(50)
activate AC
AC -> VC : 2.1.2.2.1. setVolume(50)
activate VC
VC --> AC : 2.1.2.2.2. return
deactivate VC
AC --> BC : 2.1.2.3. return
deactivate AC
BC --> SM : 2.1.3. return
deactivate BC
SM --> View : 2.2. notifyVolumeChanged()
deactivate SM

@enduml
