@startuml "seq_playback"
title CONTROLLER LAYER - Playback Control Flow (Play/Pause)
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center

actor User
participant "View\n(ImGuiView)" as View #LightGreen
participant "AppController" as AC
participant "PlaybackControllerImpl" as PBC
participant "AudioPlayer" as AP
participant "AudioPlaybackImpl" as APImpl
participant "PlayerState" as PS #LightYellow

== 1. Play ==
User -> View : 1. clickPlay()
activate View
View -> AC : 1.1. play()
activate AC
AC -> PBC : 1.1.1. play()
activate PBC

alt trackIsLoaded
    PBC -> AP : 1.1.1.1. play()
    activate AP
    AP -> APImpl : 1.1.1.1.1. play()
    activate APImpl
    APImpl -> APImpl : 1.1.1.1.1.1. resumeMusic()
    APImpl --> AP : 1.1.1.1.2. return
    deactivate APImpl
    AP --> PBC : 1.1.1.2. return
    deactivate AP
    PBC -> PS : 1.1.1.3. setPlaybackState(PLAYING)
    activate PS
    PS --> PBC : 1.1.1.4. return
    deactivate PS
else noTrackLoaded
    PBC --> AC : 1.1.2. return error
end

PBC --> AC : 1.1.2. return
deactivate PBC
AC --> View : 1.2. triggerCallback()
deactivate AC
View --> User : 2. updateUI()
deactivate View

== 3. Pause ==
User -> View : 3. clickPause()
activate View
View -> AC : 3.1. pause()
activate AC
AC -> PBC : 3.1.1. pause()
activate PBC
PBC -> AP : 3.1.1.1. pause()
activate AP
AP -> APImpl : 3.1.1.1.1. pause()
activate APImpl
APImpl -> APImpl : 3.1.1.1.1.1. pauseMusic()
note right of APImpl : Pause giữ nguyên\nvị trí phát hiện tại
APImpl --> AP : 3.1.1.1.2. return
deactivate APImpl
AP --> PBC : 3.1.1.2. return
deactivate AP
PBC -> PS : 3.1.1.3. setPlaybackState(PAUSED)
activate PS
PS --> PBC : 3.1.1.4. return
deactivate PS
PBC --> AC : 3.1.2. return
deactivate PBC
AC --> View : 3.2. triggerCallback()
deactivate AC
View --> User : 4. updateUI()
deactivate View

@enduml
